# Postgres connection string (Neon or Supabase). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:password@host:5432/priors

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob store for item, tag and receipt photos (private). Without it, dev stores photos in .uploads/.
BLOB_READ_WRITE_TOKEN=
